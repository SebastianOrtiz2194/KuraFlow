    {
      "type": "GRAMMAR",
      "title": "Present Simple Basics",
      "description": "Learn the fundamentals of present simple verbs.",
      "sortOrder": 1,
      "lessons": [
        {
          "title": "I, You, We, They",
          "description": "How to use regular verbs in present simple with plural pronouns.",
          "sortOrder": 1,
          "estimatedMinutes": 5,
          "xpReward": 10,
          "content": [
            {
              "contentType": "EXPLANATION",
              "sortOrder": 1,
              "title": "Present Simple Tense",
              "body": {
                "html": "<p>We use the present simple for habits and facts. For <b>I</b>, <b>you</b>, <b>we</b>, and <b>they</b>, use the base form of the verb.</p>",
                "tips": ["I eat apples.", "They drink water."]
              }
            },
            {
              "contentType": "QUIZ_MCQ",
              "sortOrder": 2,
              "title": "Knowledge Check",
              "body": {
                "question": "They ___ coffee every morning.",
                "options": ["drinks", "drink", "drinking"],
                "correct": 1,
                "explanation": "Use 'drink' with 'They'."
              }
            }
          ]
        },
        {
          "title": "He, She, It",
          "description": "How to use regular verbs in present simple with singular pronouns.",
          "sortOrder": 2,
          "estimatedMinutes": 5,
          "xpReward": 10,
          "content": [
            {
              "contentType": "EXPLANATION",
              "sortOrder": 1,
              "title": "Adding -s or -es",
              "body": {
                "html": "<p>For <b>he</b>, <b>she</b>, and <b>it</b>, add <b>-s</b> or <b>-es</b> to the verb.</p>",
                "tips": ["He eats apples.", "She watches TV."]
              }
            },
            {
              "contentType": "QUIZ_MCQ",
              "sortOrder": 2,
              "title": "Knowledge Check",
              "body": {
                "question": "She ___ a book.",
                "options": ["read", "reading", "reads"],
                "correct": 2,
                "explanation": "Add -s to the verb for 'She'."
              }
            }
          ]
        }
      ],
      "flashcardDecks": [
        {
          "title": "Present Simple Verbs",
          "description": "Common verbs in present simple",
          "flashcards": [
