            {
              "front": { "text": "to read", "pronunciation": "/riːd/" },
              "back": { "text": "leer (Spanish), lire (French), 読む (Japanese)", "example": "She reads a book.", "notes": "irregular past" },
              "tags": ["verb", "A1"],
              "sortOrder": 3
            }
          ]
        }
      ]
    },
    {
      "type": "VOCABULARY",
      "title": "Basic Greetings",
      "description": "Learn how to say hello and goodbye.",
      "sortOrder": 2,
      "lessons": [
        {
          "title": "Saying Hello",
          "description": "Common ways to greet people.",
          "sortOrder": 1,
          "estimatedMinutes": 5,
          "xpReward": 10,
          "content": [
            {
              "contentType": "EXPLANATION",
              "sortOrder": 1,
              "title": "Formal vs Informal",
              "body": {
                "html": "<p>Use <b>Hello</b> or <b>Good morning</b> in formal situations. Use <b>Hi</b> or <b>Hey</b> with friends.</p>",
                "tips": ["Hello, Mr. Smith.", "Hi, Sarah!"]
              }
            }
          ]
        }
      ],
